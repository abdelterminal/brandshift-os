# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres connection string used by the app, drizzle-kit and the seed script.
# Local development (Postgres published on loopback only):
DATABASE_URL=postgres://brandshift:change-me@127.0.0.1:5432/brandshift
# Inside Docker Compose the app talks to the db service instead:
# DATABASE_URL=postgres://brandshift:change-me@db:5432/brandshift

# HS256 signing key for session JWTs. At least 32 bytes of randomness.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# How long a session stays valid. Accepts a duration string: 30m, 12h, 7d, 30d.
SESSION_TTL=7d

# ---------------------------------------------------------------------------
# Mail.

# How mail leaves, if it leaves at all.
#   outbox  the default, and what a LAN deployment runs. Every message is
#           recorded in full and nothing is sent; read them under Settings.
#   smtp    deliver over SMTP. Set this when this moves to a host that has
#           a mail server. Nothing else changes -- messages already queued
#           are still there to send.
MAIL_DRIVER=outbox

# Where a link in an email points. On a local network this must be the
# machine's address on that network, not localhost: somebody opening an
# invitation on their own laptop has to be able to reach it from there.
APP_URL=http://192.168.1.10:3000

# Only read when MAIL_DRIVER=smtp.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=BrandShift OS <no-reply@example.com>

# ---------------------------------------------------------------------------
# Read by docker-compose.yml only.

# Host port the database is published on, loopback only. Move it if something
# else already holds 5432 locally, and match DATABASE_URL above.
DB_PORT=5432

# Host port the app is published on, reachable across the local network.
APP_PORT=3000

POSTGRES_USER=brandshift
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brandshift

# Where Chromium is, for rendering quotes and invoices to PDF.
# Set inside the Docker image; leave blank locally and Playwright's own
# browser (installed for the e2e suite) is found instead.
# PDF_CHROMIUM_PATH=/usr/bin/chromium-browser

# ---------------------------------------------------------------------------
# Read at build time, not at container start. Changing this needs a rebuild
# (`docker compose build app`), not just a restart -- the value is compiled
# into next/link, every asset URL, and every redirect.

# Leave unset for the ordinary deployment, where the app owns the whole
# origin -- a LAN box, or its own subdomain. Set it only when this shares a
# domain with something else and has to live under a sub-path of it, e.g.
# NEXT_PUBLIC_BASE_PATH=/os to serve at example.com/os. Nginx (or whatever
# sits in front) then has to route that same prefix to the app -- see
# DECISIONS.md.
# NEXT_PUBLIC_BASE_PATH=
